{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "financas-casal",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // App web (pasta public) servido pelo mesmo Worker; /api/* vai para o código
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Banco de dados (já criado no Cloudflare)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "financas-casal",
      "database_id": "43e30653-e84f-455a-ae69-0f8ab0ecc272",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI (gratuito na cota diária): transcreve áudio e lê foto/texto
  "ai": { "binding": "AI" },

  "vars": {
    // Nomes que aparecem no app, separados por vírgula
    "PESSOAS": "Caiam,Milena",
    "MODELO_IA_GRATIS": "@cf/meta/llama-4-scout-17b-16e-instruct",
    // Só usado se o segredo ANTHROPIC_API_KEY existir
    "MODELO_IA": "claude-haiku-5-5"
  }

  // Segredos (não ficam no código), cadastre no painel do Cloudflare:
  //   APP_PIN            -> senha que vocês digitam no app
  //   ANTHROPIC_API_KEY  -> OPCIONAL: troca a IA gratuita pelo Claude (mais preciso, pago)
}
